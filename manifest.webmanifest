{
  "name": "Fireplace Prototype",
  "short_name": "Fireplace",
  "id": "./",
  "description": "Smart home fireplace control prototype",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b0b0c",
